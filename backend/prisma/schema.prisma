// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model devices {
  id Int @id @default(autoincrement())
  macAddress String @unique
  vendor String @default("Unknown")
  deviceType String @default("Unknown")

  confidence  Decimal @db.Decimal(5, 2) @default(0)

  updates Int @default(1)
  lastSeen DateTime @updatedAt
  firstSeen DateTime @default(now())
  lastDecay DateTime @default(now())

  Phone Int @default(0)
  Tablet Int @default(0)
  Laptop Int @default(0)
  Desktop Int @default(0)
  SmartTV Int @default(0)
  StreamingDevice Int @default(0)
  GameConsole Int @default(0)
  Router Int @default(0)
  AccessPoint Int @default(0)
  Switch Int @default(0)
  Printer Int @default(0)
  Scanner Int @default(0)
  Camera Int @default(0)
  SmartSpeaker Int @default(0)
  Iot Int @default(0)
  Nas Int @default(0)
  Server Int @default(0)
  Industrial Int @default(0)
  Gateway Int @default(0)
  Unknown Int @default(0)
}

model users {
  id Int @id @default(autoincrement())
  username String @unique
  password String
  email String @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  isActive Boolean @default(true)
}

